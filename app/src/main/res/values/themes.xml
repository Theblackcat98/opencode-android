<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; all UI is Compose (see OpenCodeTheme). -->
    <style name="Theme.OpenCode" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/opencode_paper</item>
    </style>

    <style name="Theme.OpenCode.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/opencode_paper</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.OpenCode</item>
    </style>
</resources>
