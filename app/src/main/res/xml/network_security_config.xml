<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Permits cleartext LAN traffic to local OpenCode server instances,
      and trusts both system and user-installed CA certificates for self-hosted HTTPS setups.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
