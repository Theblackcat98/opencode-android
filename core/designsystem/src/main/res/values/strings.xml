<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The markdown renderer's own punctuation.

      A list marker is not decoration: a screen reader reads it out before every item, and which
      marker a locale uses is a translator's decision, not a composable's. Kept in one place so the
      plain and the annotated renderer cannot disagree about what a bullet looks like.
    -->
    <string name="md_bullet_marker" translatable="false">•  </string>
    <!-- A numbered item's marker, with its number: "%1$d.  " renders "3.  " for start=1, position=2. -->
    <string name="md_numbered_list_marker" translatable="false">%1$d.  </string>
    <!-- The code block header: the label when a fence names no language, and the copy button. -->
    <string name="md_code_plain">text</string>
    <string name="md_code_copy">Copy code</string>
    <string name="md_code_copied">Copied</string>

    <!--
      The diff viewer's "no newline at end of file" note. The leading spaces and the backslash
      are the diff convention; \u0020 keeps the spaces through aapt's whitespace trimming.
    -->
    <string name="diff_no_newline_suffix">\u0020\u0020\ No newline at end of file</string>

    <!--
      The full relative time, for content descriptions. TalkBack cannot use the "3m" abbreviation
      the sighted UI shows, so these are the words it reads instead.
    -->
    <string name="relative_time_just_now">just now</string>
    <plurals name="relative_time_minutes_ago">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="relative_time_hours_ago">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="relative_time_days_ago">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>

    <!--
      The top bar's back button. Screens may override it with [backDescription] when "back" means
      something more specific, but no back button ever goes unlabeled.
    -->
    <string name="top_app_bar_back">Back</string>

    <!-- The bottom bar's badge, read by TalkBack: "%1$d" is the capped count, "%2$s" the tab label. -->
    <string name="navigation_bar_badge_description">%1$s, %2$d notifications</string>
</resources>
