<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- OkHttp needs INTERNET, and the connectivity monitor reads the active network. Both are
         declared here as well as in the app, so a library consumer of this module is correct
         without having to remember them, and so lint can verify the calls. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

</manifest>
