    <!--
      Undo, redo and fork have no strings of their own here on purpose. Their UI belongs to the two
      features that own it: the timeline offers "undo to here" and "fork from here" on a user message,
      and the composer shows the staged-revert banner and the commit-then-send note. A second set of
      sentences here would be a second thing to translate and a second thing to disagree, so the
      Phase 6 module declares none of them. The one message a review does own is a failure, and it
      says which step failed because "the undo did not work" is not actionable.
    -->
    <string name="revert_failed_step">%1$s: %2$s</string>

