    <string name="quick_ask_model">Model (optional)</string>
    <string name="quick_ask_model_help">Written as provider/model. Leave it empty for the server\'s default, if it has one.</string>
    <string name="quick_ask_model_invalid">Write the model as provider/model, such as fake/text.</string>
    <string name="quick_ask_prompt">Prompt</string>
    <string name="quick_ask_ask">Ask</string>
    <string name="quick_ask_asking">Asking the server…</string>
    <string name="quick_ask_answer">Answer</string>

    <!-- The RPC console: a call to a plugin method, sent as JSON. -->
    <string name="rpc_help">Calls a method on a plugin on the server. Nothing is assumed about its input or its answer, so the answer is shown as the JSON that came back.</string>
    <string name="rpc_id">Plugin id</string>
    <string name="rpc_method">Method</string>
